{
  "name": "infra",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "build:agent": "node ./scripts/package-agent.mjs",
    "pretest": "npm run build:agent",
    "watch": "tsc -w",
    "test": "jest",
    "test:agent": "uv run --project agent --locked python -m unittest discover -s agent/tests",
    "synth": "npm run build:agent && cdk synth",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "jest": "^30",
    "aws-cdk": "2.1148.1",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1169.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.5.0"
  }
}
